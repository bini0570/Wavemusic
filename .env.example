# ========================================================
# FRONTEND CONFIGURATION (For Vercel)
# ========================================================
# Set this in Vercel Project Settings -> Environment Variables
# Point this to your live Railway backend URL (without trailing slash)
VITE_BACKEND_URL="https://your-railway-app.up.railway.app"

# Optional WebSocket URL override (defaults automatically to wss://<VITE_BACKEND_URL>/ws)
# VITE_WS_URL="wss://your-railway-app.up.railway.app/ws"

# ========================================================
# BACKEND CONFIGURATION (For Railway)
# ========================================================
# Railway automatically assigns PORT at runtime.
PORT=3000
NODE_ENV=production
